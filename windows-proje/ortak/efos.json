    "mp3": ["-f", "ba/b", "-x", "--audio-format", "mp3", "--audio-quality", "0", "--embed-metadata", "--embed-thumbnail"],
    "listeKapali": ["--no-playlist"],
    "listeAcik": ["--yes-playlist"],
    "kaliteler": [
